# apps/site environment. Copy to apps/site/.env.local for local development.
# On Vercel, set these in the project settings (root directory apps/site).

# Public URL of the site, used for metadata, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Folder URL that holds the desktop installers, without a trailing slash.
# Example: https://github.com/OWNER/nvoke/releases/download/v0.1.0
# Leave empty to show "Coming soon" on /download.
DOWNLOAD_BASE_URL=

# Optional. Version used in the installer file names. Defaults to the version
# in apps/desktop/package.json.
DOWNLOAD_VERSION=
