# apps/site environment. Copy to apps/site/.env.local for local development.
# On Vercel, set these in the project settings (root directory apps/site).

# Public URL of the site, used for metadata, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Base URL of apps/server. The desktop sign-in page calls /v1/desktop/authorize.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Clerk, used only by the /desktop pages. Same Clerk instance as the server.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Folder URL that holds the desktop installers, without a trailing slash.
# Example: https://github.com/OWNER/nvoke/releases/download/v0.1.0
# Leave empty to show "Coming soon" on /download.
DOWNLOAD_BASE_URL=

# Optional. Version used in the installer file names. Defaults to the version
# in apps/desktop/package.json.
DOWNLOAD_VERSION=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to turn
# analytics and the cookie consent bar off. GA runs under Consent Mode v2 and
# sets no cookies until the visitor accepts.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
