# apps/site environment. Copy to apps/site/.env.local for local development.
# On Vercel, set these in the project settings (root directory apps/site).

# Public URL of the site, used for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Base URL of apps/server. The desktop sign-in page calls /v1/desktop/authorize.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Clerk, used only by the /desktop pages. Same Clerk instance as the server.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
