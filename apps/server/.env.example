# apps/server environment. Copy to apps/server/.env for development. On the VPS
# the same variables live in /opt/nvoke/.env (see deploy/README.md). Never commit .env.

# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Supabase Postgres connection string. Only needed by the worker, migrations
# and any route that touches the database. The API boots without it.
# Use the direct connection or the session pooler, both on port 5432.
# Do NOT use the transaction pooler on port 6543: it breaks prepared
# statements, which postgres.js uses by default.
# For local development use a local database instead: `pnpm --filter
# @nvoke/server cli db` prints postgres://postgres:postgres@127.0.0.1:54329/nvoke_cli
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Clerk. The secret key verifies session tokens sent by the site and looks up
# user profiles for /v1/me. The desktop app uses device tokens instead (see
# "Desktop sign-in" in CLAUDE.md).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Optional: PEM public key for networkless token verification
# (Clerk dashboard, API keys, "JWT public key").
CLERK_JWT_KEY=
# Optional: comma separated origins allowed in the token azp claim,
# for example https://nvoke.run,http://localhost:3001
CLERK_AUTHORIZED_PARTIES=
# Signing secret (whsec_...) of the Clerk webhook endpoint
# https://api.nvoke.run/webhooks/clerk, subscribed to the subscription and
# subscriptionItem events. Without it the endpoint answers 503 and plans are
# only re-read from Clerk on GET /v1/me.
CLERK_WEBHOOK_SIGNING_SECRET=

# Public URLs used in links the API hands out: billingUrl in /v1/me, the claim
# link in agent sign-up emails (SITE_URL), and the MCP OAuth metadata and
# apiBase/mcpUrl (PUBLIC_API_URL). Defaults are production.
SITE_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3000

# Agent sign-up (POST /v1/agents/signup). Needs CLERK_SECRET_KEY to create the
# user. The claim email goes through Day3 (DAY3_API_KEY below) from
# CLAIM_EMAIL_FROM, a sender on a domain verified in Day3. Without DAY3_API_KEY
# sign-up still works and the response says claimEmailSent: false.
AGENT_SIGNUP_ENABLED=true
CLAIM_EMAIL_FROM=nvoke <hello@nvoke.run>

# Comma separated origins allowed by CORS. The site calls /v1/desktop/authorize
# from the browser. Defaults to https://nvoke.run,http://localhost:3001 when unset.
# The desktop app calls the API from its main process, which needs no CORS.
CORS_ORIGINS=https://nvoke.run,http://localhost:3001

# Lead pipeline (worker). All optional; the defaults are shown.
# Jobs the worker runs at once. Up to half go to verification and up to two
# to discovery; crawls get the rest.
WORKER_CONCURRENCY=16
# Brave Search API key for "web" searches. Without it those searches fail
# with a clear error. https://api-dashboard.search.brave.com
BRAVE_SEARCH_API_KEY=
# Requests per second your Brave plan allows (1 on the free plan).
BRAVE_REQUESTS_PER_SECOND=1
# Brave spend that triggers an alert email at 80% and 100% each month. Match
# it to the usage limit in the Brave dashboard. Unset means no spend alerts.
BRAVE_MONTHLY_BUDGET_USD=
BRAVE_COST_PER_1000_USD=5
# The free web search (Mwmbl, no account): "fallback" (default) answers when
# Brave refuses us, is paused or has no key; "first" asks it before Brave and
# pays Brave only when it finds nothing; "off" is Brave alone. Its requests
# are free and never counted as Brave cost.
FREE_SEARCH=fallback
# Milliseconds between two requests to the free web search (at least 1000).
FREE_SEARCH_INTERVAL_MS=3000
# Paid Brave requests one "Describe your customer" search may make. Cached
# pages do not count. Past it the search keeps reading the free list pages it found.
ICP_BRAVE_BUDGET=120
# Ongoing "Describe your customer" searches run a fresh round once a day. Each
# round may make this many paid Brave requests, and all of them together at
# most ONGOING_DAILY_BRAVE_BUDGET a day (UTC), so the monthly Brave cap holds.
ICP_DAILY_BRAVE_BUDGET=40
ONGOING_DAILY_BRAVE_BUDGET=250
# Operator alerts (a source refusing us, spend near the budget) are emailed
# through Day3 (https://go.day3.app, API keys). ALERT_EMAIL_FROM must be on a
# domain verified in that Day3 organization. Without these, alerts are only logged.
DAY3_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
# Product Hunt API v2 developer token for "launches" searches. Without it
# launches use Show HN only.
PRODUCT_HUNT_TOKEN=
# OpenStreetMap services for "local" searches. OVERPASS_URL is a comma
# separated list; later entries are fallbacks when one is busy. Leave it
# unset for the default list of public instances. When every instance fails,
# local searches fall back to a Brave web search (if BRAVE_SEARCH_API_KEY is set).
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://z.overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://lz4.overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter
# SMTP RCPT probe used by the verifier (no mail is ever sent). Set
# SMTP_PROBE_ENABLED=false to verify with MX records only.
SMTP_PROBE_ENABLED=true
# SMTP sessions per minute over IPv4, across the worker. The VPS provider cuts
# IPv4 port 25 off for a long while after bursts (Hostinger: about 5 a minute;
# IPv6 is not throttled). 0 = no limit.
SMTP_PROBES_PER_MINUTE=5
# SMTP sessions per minute in all (IPv4 and IPv6), and to any one mail provider
# (Google, Microsoft 365, else the MX domain). One session checks a whole
# domain: a decoy and up to 5 candidate addresses. 0 = no limit.
SMTP_SESSIONS_PER_MINUTE=60
SMTP_SESSIONS_PER_PROVIDER_PER_MINUTE=20
# Probe over IPv6 when the MX host has an AAAA record, IPv4 otherwise or on failure.
SMTP_PREFER_IPV6=true
# The free email verifier's share of the session budgets (nvoke.run/tools).
# The API probes this many a minute and the worker gets the rest. 0 keeps the
# free verifier on syntax and DNS only.
TOOLS_SMTP_PROBES_PER_MINUTE=1
# Cloudflare Turnstile secret for the free tools. Unset means rate limits only;
# set it together with NEXT_PUBLIC_TURNSTILE_SITE_KEY on the site.
TURNSTILE_SECRET_KEY=
SMTP_HELO_NAME=nvoke.run
SMTP_PROBE_FROM=probe@nvoke.run

# Homepage screenshots on site profiles, for sites without a share image
# (og:image). Needs Chromium for playwright-core: deploy/deploy.sh installs it.
# Locally: pnpm --filter @nvoke/server exec playwright-core install chromium
SITE_SHOTS=false

# Claude through OpenRouter (src/ai, docs/SPEC.md "Claude"). API key from
# https://openrouter.ai/settings/keys. Without it the features that use
# Claude answer unavailable. Each account may spend a share of its plan's
# monthly price on Claude, never less than the floor (the free plan gets the floor).
OPENROUTER_API_KEY=
AI_MONTHLY_BUDGET_FLOOR_USD=1
AI_MONTHLY_BUDGET_PRICE_SHARE=0.25

# Webhooks (docs/SPEC.md, "Webhooks") only go to https URLs on public
# addresses. true also allows http and private addresses, for pointing a
# webhook at a local receiver in development. Never in production.
WEBHOOK_ALLOW_PRIVATE=false

# Server CLI (pnpm --filter @nvoke/server cli). `search` and `db` never use
# DATABASE_URL: by default they start an embedded Postgres in
# apps/server/.pgdata on CLI_PG_PORT. Set CLI_DATABASE_URL to use another
# local Postgres instead. `privacy` is the exception: it acts on DATABASE_URL
# when set (deploy/PRIVACY-RUNBOOK.md).
CLI_PG_PORT=54329
CLI_DATABASE_URL=
# `cli eval run` (pnpm eval) starts its own embedded Postgres in
# apps/server/.bench/eval/pgdata on this port, or uses CLI_DATABASE_URL.
EVAL_PG_PORT=54339
# Tests: a Postgres where the user may create databases. When unset, the
# tests start an embedded Postgres in a temp directory.
TEST_DATABASE_URL=
