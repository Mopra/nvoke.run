# apps/server environment. Copy to apps/server/.env for development. On the VPS
# the same variables live in /opt/nvoke/.env (see deploy/README.md). Never commit .env.

# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Supabase Postgres connection string. Only needed by the worker, migrations
# and any route that touches the database. The API boots without it.
# Use the direct connection or the session pooler, both on port 5432.
# Do NOT use the transaction pooler on port 6543: it breaks prepared
# statements, which postgres.js uses by default.
# For local development use a local database instead: `pnpm --filter
# @nvoke/server cli db` prints postgres://postgres:postgres@127.0.0.1:54329/nvoke_cli
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Clerk. The secret key verifies session tokens sent by the site and looks up
# user profiles for /v1/me. The desktop app uses device tokens instead (see
# "Desktop sign-in" in CLAUDE.md).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Optional: PEM public key for networkless token verification
# (Clerk dashboard, API keys, "JWT public key").
CLERK_JWT_KEY=
# Optional: comma separated origins allowed in the token azp claim,
# for example https://nvoke.run,http://localhost:3001
CLERK_AUTHORIZED_PARTIES=
# Signing secret (whsec_...) of the Clerk webhook endpoint
# https://api.nvoke.run/webhooks/clerk, subscribed to the subscription and
# subscriptionItem events. Without it the endpoint answers 503 and plans are
# only re-read from Clerk on GET /v1/me.
CLERK_WEBHOOK_SIGNING_SECRET=

# Comma separated origins allowed by CORS. The site calls /v1/desktop/authorize
# from the browser. Defaults to https://nvoke.run,http://localhost:3001 when unset.
# The desktop app calls the API from its main process, which needs no CORS.
CORS_ORIGINS=https://nvoke.run,http://localhost:3001

# Lead pipeline (worker). All optional; the defaults are shown.
# Jobs the worker runs at once. Up to half go to verification and up to two
# to discovery; crawls get the rest.
WORKER_CONCURRENCY=16
# Brave Search API key for "web" searches. Without it those searches fail
# with a clear error. https://api-dashboard.search.brave.com
BRAVE_SEARCH_API_KEY=
# Product Hunt API v2 developer token for "launches" searches. Without it
# launches use Show HN only.
PRODUCT_HUNT_TOKEN=
# OpenStreetMap services for "local" searches. OVERPASS_URL is a comma
# separated list; later entries are fallbacks when one is busy.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# SMTP RCPT probe used by the verifier (no mail is ever sent). Set
# SMTP_PROBE_ENABLED=false to verify with MX records only.
SMTP_PROBE_ENABLED=true
SMTP_HELO_NAME=nvoke.run
SMTP_PROBE_FROM=probe@nvoke.run

# Server CLI (pnpm --filter @nvoke/server cli). `search` and `db` never use
# DATABASE_URL: by default they start an embedded Postgres in
# apps/server/.pgdata on CLI_PG_PORT. Set CLI_DATABASE_URL to use another
# local Postgres instead. `privacy` is the exception: it acts on DATABASE_URL
# when set (deploy/PRIVACY-RUNBOOK.md).
CLI_PG_PORT=54329
CLI_DATABASE_URL=
# Tests: a Postgres where the user may create databases. When unset, the
# tests start an embedded Postgres in a temp directory.
TEST_DATABASE_URL=
