# apps/desktop environment. Copy to apps/desktop/.env and fill in. Never commit .env.
# Only variables prefixed with VITE_ reach the renderer, and they are baked into
# the build, so never put a secret here.

# Clerk publishable key (pk_test_... or pk_live_...). Without it the app runs
# with sign-in disabled.
VITE_CLERK_PUBLISHABLE_KEY=

# Base URL of apps/server.
VITE_API_URL=http://localhost:3000

# Set to 1 to run the renderer on built-in demo data, without the API or the
# main process bridge. The renderer also falls back to demo data when the bridge
# is missing, for example when opened in a plain browser.
VITE_MOCK=
