# apps/desktop environment. Copy to apps/desktop/.env and fill in. Never commit .env.
# VITE_ variables are baked into the build (main process and renderer), so
# never put a secret here.

# Base URL of apps/server. The main process calls it; the renderer never does.
VITE_API_URL=http://localhost:3000

# Base URL of apps/site. Sign in opens {VITE_SITE_URL}/desktop/sign-in in the
# system browser. Defaults to http://localhost:3001 in development and
# https://nvoke.run in a packaged build.
VITE_SITE_URL=http://localhost:3001

# Set to 1 to run the renderer on built-in demo data, without the API or the
# main process bridge. The renderer also falls back to demo data when the bridge
# is missing, for example when opened in a plain browser.
VITE_MOCK=
