{
  "name": "@nvoke/desktop",
  "productName": "nvoke",
  "version": "0.1.0",
  "private": true,
  "description": "nvoke desktop app, a prospecting research tool for finding companies and their public contact details",
  "author": "nvoke",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "capture": "install-electron && node scripts/capture.mjs",
    "build": "electron-vite build",
    "preview": "install-electron && electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nvoke/shared": "workspace:*",
    "@nvoke/theme": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.18",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.56.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.7",
    "zod": "^4.6.7"
  }
}
