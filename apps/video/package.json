{
  "name": "@nvoke/video",
  "version": "0.1.0",
  "private": true,
  "description": "nvoke launch film, built with Remotion.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Film out/nvoke-film.mp4",
    "render:square": "remotion render src/index.ts FilmSquare out/nvoke-film-square.mp4",
    "render:vertical": "remotion render src/index.ts FilmVertical out/nvoke-film-vertical.mp4",
    "still": "remotion still src/index.ts Film",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.536",
    "zod": "4.5.4"
  }
}
