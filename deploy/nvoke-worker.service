# nvoke worker. Lead collection jobs, separate from the API.
#
#   sudo cp deploy/nvoke-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nvoke-worker
#   journalctl -u nvoke-worker -f

[Unit]
Description=nvoke worker
Documentation=file:/opt/nvoke/deploy/README.md
After=network-online.target
Wants=network-online.target

# Give up after five restarts in two minutes so a crash loop shows up as a
# failed unit instead of hiding. These belong in [Unit]; modern systemd
# ignores them in [Service].
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple
User=nvoke
Group=nvoke
WorkingDirectory=/opt/nvoke

# Secrets only. Mode 600, owned by the nvoke user.
EnvironmentFile=/opt/nvoke/.env
Environment=NODE_ENV=production

ExecStart=/usr/bin/node apps/server/dist/worker/index.js

Restart=always
RestartSec=10

# JSON lines on stdout: journalctl -u nvoke-worker -o cat | jq
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nvoke-worker

# The worker reads config and talks to the network. If it later runs a
# headless browser (Playwright), revisit ProtectHome, PrivateDevices and
# ReadWritePaths for the browser cache.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
# V8 needs writable and executable memory for its JIT.
MemoryDenyWriteExecute=false
UMask=0077

[Install]
WantedBy=multi-user.target
